# ============================================================
# DocSaarthi — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=development
PORT=3001
WORKER_PORT=3002

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://docsaarthi:docsaarthi_dev@localhost:5432/docsaarthi

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=docsaarthi:

# ============================================================
# OBJECT STORAGE (MinIO)
# ============================================================
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=docsaarthi_minio
MINIO_SECRET_KEY=docsaarthi_minio_secret
MINIO_BUCKET=docsaarthi
MINIO_USE_SSL=false
MINIO_PRESIGN_EXPIRY_SECONDS=3600

# ============================================================
# JWT AUTH
# ============================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=change_me_generate_64_byte_random_hex_for_access_token
REFRESH_TOKEN_SECRET=change_me_generate_64_byte_random_hex_for_refresh_token
ACCESS_TOKEN_EXPIRY_SECONDS=900
REFRESH_TOKEN_EXPIRY_SECONDS=604800

# ============================================================
# COOKIE SETTINGS
# ============================================================
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=localhost

# ============================================================
# CORS
# ============================================================
CORS_ORIGIN=http://localhost:3000

# ============================================================
# AI PROVIDERS
# ============================================================
DEFAULT_LLM_PROVIDER=openai
LLM_FALLBACK_ORDER=openai,gemini
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ============================================================
# OCR
# ============================================================
OCR_PROVIDER=paddle
OCR_PADDLE_URL=http://localhost:8081
OCR_FALLBACK_THRESHOLD=0.70
OCR_VLM_PROVIDER=gemini

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_SEARCH_PER_MIN=60
RATE_LIMIT_AUTH_WINDOW_MIN=15
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5

# ============================================================
# DOCUMENT LIMITS
# ============================================================
MAX_FILE_SIZE_BYTES=52428800
MAX_PAGES_PER_DOCUMENT=100

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=debug

# ============================================================
# NEXT.JS FRONTEND (prefix with NEXT_PUBLIC_ to expose to browser)
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:3001
