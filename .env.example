# ============================================================
# DocSaarthi — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=development
PORT=3001

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://docsaarthi:docsaarthi_dev@localhost:5432/docsaarthi

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=docsaarthi:

# ============================================================
# OBJECT STORAGE (MinIO)
# ============================================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=docsaarthi_minio
MINIO_SECRET_KEY=docsaarthi_minio_secret
MINIO_BUCKET=docsaarthi
MINIO_USE_SSL=false
MINIO_PRESIGN_EXPIRY_SECONDS=3600

# ============================================================
# JWT AUTH
# ============================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=change_me_generate_64_byte_random_hex_for_access_token
REFRESH_TOKEN_SECRET=change_me_generate_64_byte_random_hex_for_refresh_token
ACCESS_TOKEN_EXPIRY_SECONDS=900
REFRESH_TOKEN_EXPIRY_SECONDS=604800

# ============================================================
# COOKIE SETTINGS
# ============================================================
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# ============================================================
# CORS
# ============================================================
CORS_ORIGIN=http://localhost:3000

# ============================================================
# AI PROVIDERS (Groq Free Tier + Cohere)
# ============================================================
DEFAULT_LLM_PROVIDER=groq
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_your_groq_api_key_here

# Groq's OpenAI-compatible endpoint takes a BARE model id. A 'groq/' prefix
# is LiteLLM/OpenRouter routing syntax and returns 404 here.
DEFAULT_LLM_MODEL=openai/gpt-oss-120b
DEFAULT_VISION_MODEL=gemini-3.5-flash

# Embeddings → Cohere
EMBEDDING_PROVIDER=cohere
COHERE_API_KEY=your_cohere_api_key_here
EMBEDDING_API_KEY=your_cohere_api_key_here
DEFAULT_EMBEDDING_MODEL=embed-v4.0
# Must match the width of the document_embeddings.embedding pgvector column
# (see packages/database/prisma/sql/001_vector_and_search_indexes.sql).
EMBEDDING_DIMENSION=1536
# When the embedding provider is unreachable, the pipeline can fall back to
# deterministic local hash vectors. They keep processing moving but are NOT
# semantic — affected chunks are stored under model 'local-hash-fallback' and
# will not be found by semantic search until re-embedded. Set to false to fail
# the stage and let the job retry instead.
ALLOW_FALLBACK_EMBEDDINGS=true

# How much OCR text to send to the field-extraction call, and how many tokens
# the response may use. Too small a response budget truncates the JSON and
# yields zero extracted fields.
EXTRACTION_TEXT_BUDGET_CHARS=16000
EXTRACTION_MAX_RESPONSE_TOKENS=4000

# ============================================================
# OCR
# ============================================================
OCR_PROVIDER=paddle
OCR_PADDLE_URL=http://localhost:8081
OCR_FALLBACK_THRESHOLD=0.70
# Per-page timeout for the PaddleOCR sidecar, and how long to stop calling it
# after a failure. Without the circuit breaker, a hung sidecar cost a full
# timeout per page and blew past the job timeout on multi-page documents.
OCR_PADDLE_TIMEOUT_MS=120000
OCR_CIRCUIT_OPEN_MS=60000

# ============================================================
# DOCUMENT LIMITS
# ============================================================
MAX_FILE_SIZE_BYTES=52428800
MAX_PAGES_PER_DOCUMENT=100

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=debug
# Echo every Prisma query to stdout. Very noisy — the pipeline issues hundreds
# of queries per document.
PRISMA_LOG_QUERIES=false

# ============================================================
# NEXT.JS FRONTEND (prefix with NEXT_PUBLIC_ to expose to browser)
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:3001
